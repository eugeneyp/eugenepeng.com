---
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'background-education', text: 'Background & Education' },
  { depth: 2, slug: 'fun-facts-hobbies', text: 'Fun Facts & Hobbies' }
]
---

<PageLayout title='About' {headings}>
  <div class='space-y-6'>
    <section id='about-me'>
      <h2 class='text-xl font-medium sm:text-2xl mb-4'>About Me</h2>
      <p>
        Hi, I'm Eugene. I am a Product Manager by profession, an Engineer by training, and a Mystic
        at heart.
      </p>
      <p class='mt-4'>
        My primary interest is in applying the best practices in product management, systems
        thinking, and IoT/AI/ML engineering to increase reliability and resilience in the
        industrial, manufacturing, and energy sectors—the vital infrastructure that keeps our
        societies running.
      </p>
    </section>

    <section id='background-education'>
      <h2 class='text-xl font-medium sm:text-2xl mb-4 mt-8'>Background & Education</h2>
      <p>
        I am a Chinese-Canadian based out of Toronto, Ontario. I was born in the mountains of China,
        but also had the privilege of living in Scotland, Taiwan, Singapore, and Norway at various
        times.
      </p>
      <p class='mt-4'>
        Academically, I hold a Bachelor of Mechatronics Engineering from the University of Waterloo,
        and a Master of Design in Strategic Foresight and Innovation from OCAD University.
      </p>
    </section>

    <section id='fun-facts-hobbies'>
      <h2 class='text-xl font-medium sm:text-2xl mb-4 mt-8'>Fun Facts & Hobbies</h2>
      <ul class='list-disc list-inside space-y-2 mt-4'>
        <li>I took flying lessons and learned how to recover airplanes out of spins and stalls.</li>
        <li>I walked the Camino de Santiago, an 800 km pilgrimage across Spain.</li>
      </ul>
      <p class='mt-4'>
        In my free time, you can find me enjoying my hobbies: reading, meditation, neigong, and
        playing pickleball.
      </p>
    </section>
  </div>
</PageLayout>
