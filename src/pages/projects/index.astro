---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'

const projects = await getCollection('project')

// Sort by publish date (newest first)
projects.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

const aiProjectIds = ['chess-nanozero', 'connect4-alphazero', 'chess-ai']
const foresightProjectIds = [
  'foresight-informed-agile',
  'future_of_democracy',
  'how_to_face_complexity',
  'instagram_mental_health',
  'quick_guide_foresight'
]

const aiProjects = projects.filter((project) => aiProjectIds.includes(project.id))
const foresightProjects = projects.filter((project) => foresightProjectIds.includes(project.id))

const headings = [
  { depth: 2, slug: 'ai-ml', text: 'AI / ML' },
  { depth: 2, slug: 'strategic-foresight-innovation', text: 'Strategic Foresight & Innovation' }
]
---

<PageLayout title='Projects' {headings} view>
  <div class="space-y-12 mt-8">
    <section id="ai-ml">
      <h2 class="text-xl font-medium sm:text-2xl mb-4">AI / ML</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {aiProjects.map((project) => (
          <ProjectCard
            heading={project.data.title}
            subheading={project.data.description}
            href={`/projects/${project.id}`}
          />
        ))}
      </div>
    </section>

    <section id="strategic-foresight-innovation">
      <h2 class="text-xl font-medium sm:text-2xl mb-4">Strategic Foresight & Innovation</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {foresightProjects.map((project) => (
          <ProjectCard
            heading={project.data.title}
            subheading={project.data.description}
            href={`/projects/${project.id}`}
          />
        ))}
      </div>
    </section>
  </div>
</PageLayout>
